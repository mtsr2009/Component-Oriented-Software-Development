@model OnlineFoodDelivery.Models.SubMenu
@Html.Partial("~/Views/_PageNavigation.cshtml")
@{
    ViewBag.Title = "Edit";
}

<h2>Edit Sub Menu</h2>


<form action="/SubMenus/Edit" method="post">
    <div>
        <input type="text" id="mySubMenuID" name="mySubMenuID" value="@Model.mySubMenuID" />
    </div>
    <div>
        <label>Select Restaurant</label>
        @Html.DropDownList("RestaurantID", null, "")
    </div>
    <div>
        <label>Select Main Menu</label>
        @Html.DropDownList("MainMenuID", null, "")
    </div>
    <div>
        <label>Sub Menu</label>
        @Model.SubMenu1
        <input type="text" id="SubMenu1" name="SubMenu1" value="@Model.SubMenu1" />
    </div>
    <div>
        <label>Size</label>
        <input type="text" id="Size" name="Size" value="@Model.Size" />
    </div>
    <div>
        <label>Quantity</label>
        <input type="text" id="Quantity" name="Quantity" value="@Model.Quantity" />
    </div>
    <div>
        <label>Price</label>
        <input type="text" id="Price" name="Price" value="@Model.Price" />
    </div>

    <div>
        <button type="submit">Create</button>
    </div>
</form>
