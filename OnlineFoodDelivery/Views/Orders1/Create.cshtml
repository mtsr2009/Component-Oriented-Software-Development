@model OnlineFoodDelivery.Models.Order
@Html.Partial("~/Views/_PageNavigation.cshtml")
@{
    ViewBag.Title = "Create";
}

<h2>Place Order</h2>
<form action="/Orders1/Create" method="post">
    <div>
        <div><label>Customer Name</label></div>
        @Html.DropDownList("CustomerID", null, "")
    </div>
    <div>
        <div><label>Restaurant Name</label></div>
        @Html.DropDownList("RestaurantID", null, "")
    </div>
    <div>
        <div><label>Select Order</label></div>
        @Html.DropDownList("mySubMenuID", null, "")
    </div>

    <div>
        <div><label>Quantity</label></div>
        <input type="text" placeholder="Quantity" id="Quantity" name="Quantity" />
    </div>
    <div>
        <div><label>Order Date</label></div>
        <input type="date" placeholder="Date" id="Date" name="Date" />
    </div>
    <div>
        <div><label>Order Time</label></div>
        <input type="time" placeholder="Time" id="Time" name="Time" />
    </div>
    <div>
        <button type="submit">Submit</button>
    </div>
</form>


