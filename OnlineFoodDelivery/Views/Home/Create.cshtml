@model OnlineFoodDelivery.Models.Restaurant

@Html.Partial("~/Views/_PageNavigation.cshtml")

<h2>Create New Restaurant</h2>

<form action="/Home/submittCreate" method="post">
    <div>
        <div><label>Restuarant Name</label></div>
        <input type="text" placeholder="Restuarant Name" id="RestuarantName" name="RestuarantName" />
    </div>
    <div>
        <div><label>Country</label></div>
        <input type="text" placeholder="Country" id="Country" name="Country"/>
    </div>
    <div>
        <div><label>State</label></div>
        <input type="text" placeholder="" id="State" name="State"/>
    </div>
    <div>
        <div><label>Address</label></div>
        <input type="text" placeholder="Address" id="Address" name="Address" />
    </div>
    <div>
        <div><label>Contact</label></div>
        <input type="text" placeholder="Contact" id="Contact" name="Contact" />
    </div>
    <div>
        <div><label>Email Address</label></div>
        <input type="text" placeholder="Email Address" id="EmailAddress" name="EmailAddress" />
    </div>

    <hr />
    <div>
        <button type="submit">Submit</button>
    </div>

</form>

