@model IEnumerable<OnlineFoodDelivery.Models.vOrder>
@Html.Partial("~/Views/_PageNavigation.cshtml")

@{
    ViewBag.Title = "Index";
}

<h2>Delivered Orders</h2>

<div class="row">
    <form action="/Orders1/Index" method="get">
        @Html.DropDownList("RestaurantID", null, "")
        <button type="submit">Search</button>
    </form>
</div>
<hr />

<p>
    <a href="/Orders1/Create">Ongoing Orders</a>
</p>

<hr />
<table class="table">
    <tr>
        <th>
            Customer Name
        </th>
        <th>
            Restaurant Name
        </th>
        <th>
            Order Details
        </th>
        <th>
            Quantity
        </th>
        <th>
            Price
        </th>
        <th>
            Order Date
        </th>
        <th>
            Order Time
        </th>
        <th>Delivered</th>
        <th>
            Status
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @item.CustomerFullName
            </td>
            <td>
                @item.RestuarantName
            </td>
            <td>
                @item.SubMenu1 @item.Size
            </td>
            <td>
                @item.Quantity
            </td>
            <td>
                @item.Price
            </td>
            <td>
                @item.Date
            </td>
            <td>
                @item.Time
            </td>
            <td>
                @item.DeliveryDate - @item.DeliveryTime
            </td>
            @{
                if (item.OrderStatus == 1)
                {
                    <td>
                        Pending
                    </td>
                }
                else if (item.OrderStatus == 2)
                {
                    <td>
                        Preparing
                    </td>
                }
                else if (item.OrderStatus == 3)
                {
                    <td>
                        Delivered
                    </td>
                }
                else if (item.OrderStatus == 4)
                {
                    <td>
                        Cancelled
                    </td>
                }

            }

            <td>
            </td>
        </tr>
    }

</table>
