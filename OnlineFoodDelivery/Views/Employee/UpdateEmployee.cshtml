@model OnlineFoodDelivery.Models.User

@Html.Partial("~/Views/_PageNavigation.cshtml")
<h2>Modify Staff</h2>

<form action="/Employee/fnUpdateEmployee" method="post">
    <div>
        <input type="hidden" id="StaffId" name="StaffId" value="@Model.StaffID" />
    </div>
    <div>
        <div><label>Select Restaurant Name</label></div>
        @Html.DropDownList("RestaurantID", null, "")
        @*  @Html.DropDownList("RestaurantID", null, "", htmlAttributes: new { @value = "@Model.RestaurantID" })*@
    </div>
    <div>
        <div><label>Staff Full Name</label></div>
        <input type="text" placeholder="Staff Full Name" id="StaffFullName" name="StaffFullName" value="@Model.StaffFullName" />
    </div>
    <div>
        <div><label>Address</label></div>
        <input type="text" placeholder="Address" id="Address" name="Address" value="@Model.Address" />
    </div>
    <div>
        <div><label>Contact</label></div>
        <input type="text" placeholder="Contact" id="Contact" name="Contact" value="@Model.Contact" />
    </div>
    <div>
        <div><label>Email</label></div>
        <input type="text" placeholder="Email" id="Email" name="Email" value="@Model.Email" />
    </div>

    <hr />
    <div>
        <button type="submit">Submit</button>
    </div>

</form>

