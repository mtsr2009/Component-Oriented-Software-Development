@model IEnumerable<OnlineFoodDelivery.Models.User>

@Html.Partial("~/Views/_PageNavigation.cshtml")

<h2>Restaurant Staff List</h2>

<div class="row">
    <form action="/Employee/Index" method="get">
        @Html.DropDownList("RestaurantID", null, "")
        <button type="submit">Search</button>
    </form>
    </div>
<hr />
<div><a href="/Employee/CreateEmployee">Register New Staff</a></div>
<hr />
<div class="row">
    <table width="100%">
        <thead>
            <tr>
                <th>Staff Full Name</th>
                <th>Restaurant Name</th>
                <th>Address</th>
                <th>Contact Number</th>
                <th>Emaill Address</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.StaffFullName</td>
                    <td>@item.Restaurant.RestuarantName</td>
                    <td>@item.Address</td>
                    <td>@item.Contact</td>
                    <td>@item.Email</td>
                    <td>
                    <a href="/Employee/UpdateEmployee?usrId=@item.StaffID">Edit</a>
                    <a href="/Employee/Delete/@item.StaffID">Delete</a>
                </td>
                </tr>
            }   
            </tbody>
    </table>
</div>

