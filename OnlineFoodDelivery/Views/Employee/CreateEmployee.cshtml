@model OnlineFoodDelivery.Models.User

@Html.Partial("~/Views/_PageNavigation.cshtml")

<h2>Register Staff</h2>

<form action="/Employee/nEmployee" method="post">
    <div>
        <div><label>Select Restaurant Name</label></div>
        @Html.DropDownList("RestaurantID", null, "")
    </div> 
    <div>
        <div><label>Staff Full Name</label></div>
        <input type="text" placeholder="Staff Full Name" id="StaffFullName" name="StaffFullName" />
    </div>
    <div>
        <div><label>Address</label></div>
        <input type="text" placeholder="Address" id="Address" name="Address" />
    </div>
    <div>
        <div><label>Contact</label></div>
        <input type="text" placeholder="Contact" id="Contact" name="Contact" />
    </div>
    <div>
        <div><label>Email</label></div>
        <input type="text" placeholder="Email" id="Email" name="Email" />
    </div>

    <hr />
    <div>
        <button type="submit">Submit</button>
    </div>

</form>

