@model OnlineFoodDelivery.Models.Customer

@Html.Partial("~/Views/_PageNavigation.cshtml")

<h2>Register Customer</h2>

<form action="/Customer/nCustomer" method="post">
    <div>
        <div><label>Restaurant Name</label></div>
        @Html.DropDownList("RestaurantID", null, "")
    </div>  
    <div>
        <div><label>Customer Full Name</label></div>
        <input type="text" placeholder="Customer Full Name" id="CustomerFullName" name="CustomerFullName" />
    </div>
    <div>
        <div><label>Address</label></div>
        <input type="text" placeholder="Address" id="Address" name="Address" />
    </div>
    <div>
        <div><label>Contact</label></div>
        <input type="text" placeholder="Contact" id="Contact" name="Contact" />
    </div>
    <div>
        <div><label>Email</label></div>
        <input type="text" placeholder="Email" id="Email" name="Email" />
    </div>
    <hr />
    <div>
        <button type="submit">Submit</button>
    </div>
</form>

