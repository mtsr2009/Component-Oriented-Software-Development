@model IEnumerable<OnlineFoodDelivery.Models.Customer>

@Html.Partial("~/Views/_PageNavigation.cshtml")
<h2>Restaurant Customers Lists</h2>

<div class="row">
    <form action="/Customer/Index" method="get">
        @Html.DropDownList("RestaurantID", null, "")
        <button type="submit">Search</button>
    </form>
</div>
<hr />
<a href="/Customer/CreateCustomer">Register New Customer</a>
<hr />
<div class="row">
    <table width="100%">
        <thead>
            <tr>
                <th>Customer Full Name</th>
                <th>Address</th>
                <th>Contact Number</th>
                <th>Emaill Address</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CustomerFullName</td>
                    <td>@item.Address</td>
                    <td>@item.Contact</td>
                    <td>@item.Email</td>
                    <td>
                    <a href="/Customer/UpdateCustomer?id=@item.CustomerID">Edit</a>
                    <a href="/Customer/Delete?id=@item.CustomerID">Delete</a>
                    
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

